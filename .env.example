# Generate local values with make setup. Never commit .env or private keys.
PAGW_MODE=local
PAGW_BROKER=postgres
PAGW_DATABASE_URL=postgresql://pagw:local-only@127.0.0.1:55480/pagw_native
PAGW_CALLBACK_SECRET=
PAGW_WEBHOOK_SECRET=
PAGW_PAYER_CLIENT_SECRET=
PAGW_ENCRYPTION_KEY=
# Optional OTLP HTTP trace endpoint; no remote telemetry is enabled by default.
PAGW_OTLP_ENDPOINT=
